     "name": "stdin",
     "output_type": "stream",
     "text": [
      "請輸入 x:  -5\n",
      "請輸入 y:  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "虛數\n"
     ]
    }
   ],
   "source": [
    "# 如果 x 不是負數，則傳回值為 x ** (1 / y)\n",
    "# 如果 x 是負數而且 y 為偶數，則傳回值為 \"虛數\"\n",
    "# 如果 x 是負數而且 y 為奇數，則傳回值為 -(-x) ** (1 / y)\n",
    "\n",
    "x = int(input('請輸入 x: '))\n",
    "y = int(input(\"請輸入 y: \"))\n",
    "if x >= 0:\n",
    "    print(x ** (1 / y))\n",
    "else:\n",
    "    if y % 2 == 0:\n",
    "        print(\"虛數\")\n",
    "    else:\n",
    "        print(-(-x) ** (1 / y))"
   ]
  },
