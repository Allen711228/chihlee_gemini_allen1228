[Unit]
Description=Gemini News Bot - CPI 及國際能源價格推播服務
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/Documents/github/chihlee_gemini_allen1228
Environment="PATH=/home/pi/Documents/github/chihlee_gemini_allen1228/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/Documents/github/chihlee_gemini_allen1228/.venv/bin/python /home/pi/Documents/github/chihlee_gemini_allen1228/0913/practice_Text.py

# 標準輸出與錯誤記錄至 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gemini-news-bot

[Install]
WantedBy=multi-user.target
